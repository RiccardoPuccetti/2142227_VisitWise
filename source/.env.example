# Copy to .env (never commit .env). All values have safe defaults in docker-compose.yml.
POSTGRES_DB=visitwise
POSTGRES_USER=visitwise
POSTGRES_PASSWORD=visitwise

# Nominatim usage policy requires an identifying User-Agent with a contact.
# Put the team contact here, e.g. VisitWise-hackathon/0.1 (team-email@example.com)
GEOCODING_USER_AGENT=VisitWise-hackathon/0.1 (contact: change-me@example.com)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Real road routes for the planner map (public OSRM demo server, no SLA). Set ROUTING_ENABLED=false to estimate only.
ROUTING_ENABLED=true
ROUTING_BASE_URL=https://router.project-osrm.org

# Self-hosted OSRM (optional, US-39): uncomment these three lines (and remove ROUTING_BASE_URL above). The first start
# downloads the OpenStreetMap extract of central Italy from Geofabrik (about 370 MB) and prepares it once (a few minutes).
# The planner then uses road distances and driving times, and no coordinate leaves this machine.
# COMPOSE_PROFILES=osrm
# ROUTING_BASE_URL=http://osrm:5000
# ROUTING_MATRIX_ENABLED=true
# Another region: any Geofabrik .osm.pbf link (prepared again when it changes).
# OSRM_PBF_URL=https://download.geofabrik.de/europe/italy/centro-latest.osm.pbf

# Minimum password length (1-64). 8 for the demo; NIST SP 800-63B-4 recommends 15 for password-only login.
PASSWORD_MIN_LENGTH=8

# Login + registration attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Days a device stays logged in with "Keep me logged in" (US-37).
REMEMBER_ME_DAYS=14

# Liquibase contexts: dev = schema + demo tenant (demo.federation@visitwise.test / visitwise-demo).
# Use default (schema only) on the machine that holds the real data.
LIQUIBASE_CONTEXTS=dev

# Set to true when the app is served over HTTPS (Secure session cookie).
SESSION_COOKIE_SECURE=false
