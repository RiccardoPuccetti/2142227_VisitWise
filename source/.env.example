# Copy to .env (never commit .env). All values have safe defaults in docker-compose.yml.
POSTGRES_DB=visitwise
POSTGRES_USER=visitwise
POSTGRES_PASSWORD=visitwise

# Nominatim usage policy requires an identifying User-Agent with a contact.
# Put the team contact here, e.g. VisitWise-hackathon/0.1 (team-email@example.com)
GEOCODING_USER_AGENT=VisitWise-hackathon/0.1 (contact: change-me@example.com)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# Minimum password length (1-64). 8 for the demo; NIST SP 800-63B-4 recommends 15 for password-only login.
PASSWORD_MIN_LENGTH=8

# Login + registration attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Liquibase contexts: dev = schema + demo tenant (demo.federation@visitwise.test / visitwise-demo).
# Use default (schema only) on the machine that holds the real data.
LIQUIBASE_CONTEXTS=dev

# Set to true when the app is served over HTTPS (Secure session cookie).
SESSION_COOKIE_SECURE=false
