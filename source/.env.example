# Copy to .env (never commit .env). All values have safe defaults in docker-compose.yml.
POSTGRES_DB=visitwise
POSTGRES_USER=visitwise
POSTGRES_PASSWORD=visitwise

# Nominatim usage policy requires an identifying User-Agent with a contact.
# Put the team contact here, e.g. VisitWise-hackathon/0.1 (team-email@example.com)
GEOCODING_USER_AGENT=VisitWise-hackathon/0.1 (contact: change-me@example.com)
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
